#!/usr/bin/env bash
set -euo pipefail

PYTHON_BIN="$HOME/.local/pipx/venvs/edge-tts/bin/python"
if [[ ! -x "$PYTHON_BIN" ]]; then
    PYTHON_BIN="$HOME/Library/Application Support/pipx/venvs/edge-tts/bin/python"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$PYTHON_BIN" "$SCRIPT_DIR/_tts_backend.py" tts "$@"
